POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rdc_ncr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# POSTGRES_SSLMODE=disable
# CONN_MAX_AGE=600
TIME_ZONE=Asia/Manila

# Alternative single-value PostgreSQL config:
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/rdc_ncr_db

# Email (SMTP)
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@domain.com
# EMAIL_HOST_PASSWORD=your_email_password_or_app_password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=RDC Portal <no-reply@yourdomain.com>
# EMAIL_WEBHOOK_URL=https://your-email-webhook.example.com/send
# EMAIL_WEBHOOK_SECRET=change-me
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=RDC Portal <no-reply@yourdomain.com>

# Frontend URL for setup links
# FRONTEND_BASE_URL=http://localhost:5173

# Password reset request protections
# PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
# PASSWORD_RESET_RATE_LIMIT_EMAIL=2
# PASSWORD_RESET_RATE_LIMIT_IP=5

# Cloudflare Turnstile (optional)
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# TURNSTILE_REQUIRED=false

# AI project scoring (optional; falls back to local keyword scoring when unset)
# GROQ_API_KEY=your_groq_api_key
